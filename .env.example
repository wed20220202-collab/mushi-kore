# Firebase Web SDK (ブラウザ公開値。Firebase Consoleから取得)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# Firebase Admin SDK (サーバー専用)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Google Drive: 製作者OAuth（個人マイドライブ方式）
GOOGLE_DRIVE_AUTH_MODE=oauth
GOOGLE_DRIVE_OAUTH_CLIENT_FILE=
GOOGLE_DRIVE_OAUTH_TOKEN_FILE=
GOOGLE_DRIVE_OAUTH_REDIRECT_URI=http://127.0.0.1:3000/api/google-drive/oauth/callback
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=

# ローカルでFirebase Adminを使う場合。JSON本体はGit管理しない
GOOGLE_APPLICATION_CREDENTIALS=

# Google Drive: 共有ドライブ方式を使う場合
GOOGLE_DRIVE_SHARED_DRIVE_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# AI provider
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=mushi-kore-demo-v1
GEMINI_API_KEY_FILE=
MAX_DAILY_AI_IDENTIFICATIONS=10
AI_RATE_LIMIT_PER_MINUTE=3

# 容量・レート制限
MAX_IMAGES_PER_USER=500
MAX_STORAGE_BYTES_PER_USER=524288000
MAX_DAILY_UPLOADS_PER_USER=30
MAX_COMPRESSED_FILE_BYTES=2097152
UPLOAD_RATE_LIMIT_PER_MINUTE=5

# 管理・運用
APP_BASE_URL=http://localhost:3000
CONTACT_EMAIL=
